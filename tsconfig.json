{
    "compilerOptions": {
        "baseUrl": "",
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "declaration": true,
        "skipLibCheck": true
    },
    "exclude": ["lib", "lib-test", "docs"],
    "typedocOptions": {
        "entryPoints": ["./src/"],
        "excludeExternals": true,
        "excludePrivate": true,
        "name": "Anyhow",
        "out": "docs"
    }
}
