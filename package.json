{
    "name": "anyhow",
    "version": "3.5.0",
    "description": "Drop-in wrapper for Winston, Bunyan, Pino and console logs.",
    "keywords": [
        "anyhow",
        "bunyan",
        "console",
        "gcloud",
        "log",
        "logger",
        "logging",
        "pino",
        "syslog",
        "stackdriver",
        "winston"
    ],
    "author": "Igor Ramadas <igor@devv.com>",
    "homepage": "https://anyhow.devv.com",
    "subdomain": "anyhow",
    "license": "MIT",
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/esm/index.d.ts",
                "default": "./lib/esm/index.js"
            },
            "require": {
                "types": "./lib/cjs/index.d.ts",
                "default": "./lib/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/igoramadas/anyhow.git"
    },
    "engines": {
        "node": ">= 16.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig-build.json && tsc -p tsconfig-esm.json && node scripts/postbuild.js",
        "build-test": "tsc -p tsconfig-test.json",
        "clean": "rm -rf ./lib && rm -rf ./lib-test && rm -rf ./coverage && rm -rf ./docs",
        "prebuild": "npm run clean",
        "docs": "rm -rf ./docs && typedoc && cp CNAME docs/ && cp .nojekyll docs/",
        "test": "npm run build-test && mocha ./test/*.ts && npm run test-compat",
        "test-compat": "tsc -p tsconfig-build.json && tsc -p tsconfig-esm.json && node scripts/postbuild.js && node ./test/compat/cjs.cjs && node ./test/compat/esm.mjs && node ./test/compat/consumers.cjs",
        "test-coverage": "nyc --reporter=lcov npm test"
    },
    "devDependencies": {
        "@google-cloud/logging": "^11.2.0",
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@types/mocha": "^10.0.7",
        "@types/node": "^22.5.3",
        "axios": "^1.7.7",
        "bent": "^7.3.12",
        "bunyan": "^1.8.15",
        "capture-console": "^1.0.2",
        "chai": "^4.5.0",
        "chalk": "<5.0.0",
        "coveralls": "^3.1.1",
        "mocha": "^10.7.3",
        "mocha-lcov-reporter": "^1.3.0",
        "nyc": "^17.0.0",
        "pino": "^9.4.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.26.6",
        "typescript": "^5.5.4",
        "winston": "^3.14.2"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "mocha": {
        "timeout": 5000,
        "exit": true,
        "recursive": true,
        "require": [
            "test/mocha.env",
            "ts-node/register",
            "source-map-support/register"
        ]
    },
    "nyc": {
        "extends": "@istanbuljs/nyc-config-typescript",
        "temp-dir": "./coverage",
        "reporter": [
            "lcov",
            "text"
        ]
    },
    "dependencies": {
        "or": "^0.2.0"
    }
}
